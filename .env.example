# Environment Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram Bot & WebApp Authentication
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_BOT_USERNAME="YourUniAttendanceBot"
TELEGRAM_WEBHOOK_SECRET="random_strong_secret_token_here"
DEPT_HEAD_TELEGRAM_ID="123456789" # Department Head's Telegram User ID for alerts & Friday digest

# Database Configuration (Neon PostgreSQL)
# Pooled URL for serverless execution
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct URL for migrations
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis (Serverless KV & Rate Limiting)
UPSTASH_REDIS_REST_URL="https://sample.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_token_here"

# Vercel Cron Secret (for protecting scheduled routes)
CRON_SECRET="sample_cron_secret_here"
